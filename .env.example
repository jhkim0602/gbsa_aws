APP_ENVIRONMENT=local-production
APP_NAME=interview-evidence-platform
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080

POSTGRES_DB=interview_evidence
POSTGRES_USER=iep
POSTGRES_PASSWORD=local-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://iep:local-only-password@postgres:5432/interview_evidence

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
DYNAMODB_ENDPOINT_URL=http://dynamodb:8000
DYNAMODB_TABLE_NAME=iep-local-interview-context
DYNAMODB_PORT=8000
LOCALSTACK_PORT=4566
OPENSEARCH_ENDPOINT=http://opensearch:9200
OPENSEARCH_INDEX_NAME=candidate-source-v1
OPENSEARCH_SIGN_REQUESTS=false
OPENSEARCH_PORT=9200
SOURCE_BUCKET=iep-local-source
MEDIA_BUCKET=iep-local-media
KMS_KEY_ARN=local-kms-key
SQS_ANALYSIS_QUEUE_URL=http://localstack:4566/000000000000/iep-analysis
SQS_MEDIA_QUEUE_URL=http://localstack:4566/000000000000/iep-media
SQS_REPORTING_QUEUE_URL=http://localstack:4566/000000000000/iep-reporting
SQS_DELETION_QUEUE_URL=http://localstack:4566/000000000000/iep-deletion
SES_FROM_ADDRESS=no-reply@local.interview-evidence.test
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
BEDROCK_MODEL_ID=local-deterministic-model
MEDIACONVERT_ROLE_ARN=arn:aws:iam::000000000000:role/local-mediaconvert

# Optional read-only GitHub token for public-repository analysis. Anonymous callers get
# 60 API requests an hour and one analysis can spend that alone; a token raises it to
# 5000. Needs no scopes for public repositories. Leave empty to stay anonymous.
GITHUB_TOKEN=

COMPANY_CONSOLE_PORT=5173
APPLICANT_INTERVIEW_PORT=5174

# Local-only opaque values. Never place real applicant data or credentials here.
COMPANY_AUTH_FAKE_SUBJECT=00000000-0000-7000-8000-000000000001
APPLICANT_AUTH_FAKE_SUBJECT=00000000-0000-7000-8000-000000000002
LOCAL_COMPANY_TOKEN=local-company-token
LOCAL_COMPANY_ID=00000000-0000-7000-8000-000000000001
LOCAL_COMPANY_USER_ID=00000000-0000-7000-8000-000000000002
