# Local development settings. Copy to `.env` and fill in the AWS section.
#
# The API and the worker run the same wiring as production (`create_production_runtime`), with
# four AWS services pointed at containers and the rest pointed at real AWS. Hostnames are
# `localhost`, not compose service names: these processes run on the host, not in the network.

APP_ENVIRONMENT=local
APP_NAME=interview-evidence-platform
APP_LOG_LEVEL=INFO

POSTGRES_DB=interview_evidence
POSTGRES_USER=iep
POSTGRES_PASSWORD=local-only-password
POSTGRES_PORT=5432

# `psycopg`, matching `RequestScopedDatabase`, which builds a synchronous engine. The `asyncpg`
# URL this file used to carry fails at connect -- the driver is not installed.
DATABASE_URL=postgresql+psycopg://iep:local-only-password@localhost:5432/interview_evidence
# Read by `backend/alembic/env.py`. Same target, separate name, so a migration cannot silently
# inherit an application URL pointed somewhere else.
MIGRATION_DATABASE_URL=postgresql+psycopg://iep:local-only-password@localhost:5432/interview_evidence

# --- Containers ------------------------------------------------------------------------------
# Only s3, sqs, sesv2 and secretsmanager follow AWS_ENDPOINT_URL; DynamoDB has its own setting.
# Every other service ignores both and reaches real AWS -- see `runtime/aws.py:_client_factory`.
AWS_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_NAME=iep-local-interview-context
DYNAMODB_PORT=8000
LOCALSTACK_PORT=4566
SOURCE_BUCKET=iep-local-source
MEDIA_BUCKET=iep-local-media
SQS_ANALYSIS_QUEUE_URL=http://localhost:4566/000000000000/iep-analysis
SQS_MEDIA_QUEUE_URL=http://localhost:4566/000000000000/iep-media
SQS_REPORTING_QUEUE_URL=http://localhost:4566/000000000000/iep-reporting
SQS_DELETION_QUEUE_URL=http://localhost:4566/000000000000/iep-deletion
SQS_WAIT_TIME_SECONDS=1
# Consumed by `runtime.local_infra`, which creates the queues named above.
LOCAL_ANALYSIS_QUEUE_NAME=iep-analysis
LOCAL_MEDIA_QUEUE_NAME=iep-media
LOCAL_REPORTING_QUEUE_NAME=iep-reporting
LOCAL_DELETION_QUEUE_NAME=iep-deletion

# Postgres pgvector, not OpenSearch: there is no OpenSearch container here. Setting this to
# `opensearch` would then demand OPENSEARCH_ENDPOINT and fail at startup without one.
RETRIEVAL_BACKEND=aurora

# LocalStack accepts any string as a KMS key id and stores the objects unencrypted.
KMS_KEY_ARN=local-kms-key

# --- Real AWS --------------------------------------------------------------------------------
# Bedrock, Cognito, Transcribe, Polly, Textract and MediaConvert have no local substitute in
# this setup: they reach the account your credentials name, and those calls are billed. Use
# `aws sso login`, or set AWS_PROFILE, or export an access key with Bedrock invoke permission.
AWS_REGION=ap-northeast-2
# AWS_PROFILE=your-profile

# Must be enabled in AWS_REGION or every question generation fails with AccessDenied.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# No verified SES identity needed: the SES client is endpoint-overridden to LocalStack, which
# accepts any sender and delivers to nobody.
SES_FROM_ADDRESS=no-reply@local.interview-evidence.test

# MediaConvert is not endpoint-overridden. The placeholder holds until a recording is
# post-processed, where the job submission fails; a real role ARN is needed to get past that.
MEDIACONVERT_ROLE_ARN=arn:aws:iam::000000000000:role/local-mediaconvert

# --- Frontend --------------------------------------------------------------------------------
# Required -- `create_production_runtime` refuses to start without an absolute URL here. It is
# the applicant link the console puts in an invitation.
APPLICANT_ACCESS_BASE_URL=http://localhost:5174/access
COMPANY_CONSOLE_PORT=5173
APPLICANT_INTERVIEW_PORT=5174

# Optional read-only GitHub token for public-repository analysis. Anonymous callers get
# 60 API requests an hour and one analysis can spend that alone; a token raises it to
# 5000. Needs no scopes for public repositories. Leave empty to stay anonymous.
GITHUB_TOKEN=
