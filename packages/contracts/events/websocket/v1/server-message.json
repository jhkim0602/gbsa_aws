{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-evidence.local/contracts/websocket/v1/server-message.json",
  "title": "ServerMessage",
  "oneOf": [
    {
      "$ref": "#/$defs/StateChanged"
    },
    {
      "$ref": "#/$defs/Transcript"
    },
    {
      "$ref": "#/$defs/QuestionPreparing"
    },
    {
      "$ref": "#/$defs/QuestionReady"
    },
    {
      "$ref": "#/$defs/ResumeSnapshot"
    },
    {
      "$ref": "#/$defs/SessionPaused"
    },
    {
      "$ref": "#/$defs/SessionCompleted"
    },
    {
      "$ref": "#/$defs/ErrorMessage"
    }
  ],
  "$defs": {
    "Base": {
      "$ref": "./envelope.json"
    },
    "StateChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "session.state_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "previous_state",
                "state",
                "reason_code",
                "checkpoint_id"
              ],
              "properties": {
                "previous_state": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "reason_code": {
                  "type": "string"
                },
                "checkpoint_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "Transcript": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "enum": ["transcript.partial", "transcript.final"]
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "answer_turn_id",
                "segment_sequence",
                "text",
                "start_ms",
                "end_ms",
                "confidence",
                "is_final"
              ],
              "properties": {
                "answer_turn_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "segment_sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "is_final": {
                  "type": "boolean"
                },
                "transcript_segment_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "review_required": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      ]
    },
    "QuestionPreparing": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "question.preparing"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "degraded_mode"],
              "properties": {
                "stage": {
                  "enum": ["retrieval", "generation", "policy", "speech"]
                },
                "degraded_mode": {
                  "enum": ["none", "search_fallback", "text_only"]
                }
              }
            }
          }
        }
      ]
    },
    "QuestionReady": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "question.ready"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_turn_id",
                "text",
                "target_criterion_id",
                "audio_url",
                "audio_expires_at",
                "speech_marks_url",
                "source_reference_count",
                "text_only"
              ],
              "properties": {
                "question_turn_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "target_criterion_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "audio_url": {
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "audio_expires_at": {
                  "type": ["string", "null"],
                  "format": "date-time"
                },
                "speech_marks_url": {
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "source_reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "text_only": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    },
    "ResumeSnapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "resume.snapshot"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "server_sequence",
                "last_final_turn_id",
                "pending_turn",
                "last_verified_recording_chunk_sequence",
                "allowed_client_messages",
                "degraded_modes"
              ],
              "properties": {
                "state": {
                  "type": "string"
                },
                "server_sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "last_final_turn_id": {
                  "type": ["string", "null"],
                  "format": "uuid"
                },
                "pending_turn": {
                  "type": ["object", "null"],
                  "required": ["turn_id", "speaker", "status"],
                  "properties": {
                    "turn_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "speaker": {
                      "enum": ["interviewer", "applicant"]
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                },
                "last_verified_recording_chunk_sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "allowed_client_messages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "degraded_modes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "SessionPaused": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "session.paused"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_code",
                "retryable",
                "next_retry_at",
                "message"
              ],
              "properties": {
                "reason_code": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "next_retry_at": {
                  "type": ["string", "null"],
                  "format": "date-time"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "SessionCompleted": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "session.completed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "completed_at",
                "last_turn_id",
                "post_processing_status"
              ],
              "properties": {
                "completed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "last_turn_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "post_processing_status": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "ErrorMessage": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "message_type": {
              "const": "error"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "retryable",
                "current_state",
                "current_sequence"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "current_state": {
                  "type": "string"
                },
                "current_sequence": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    }
  }
}
