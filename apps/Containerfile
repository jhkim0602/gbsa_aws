FROM node:22-alpine AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/company-console/package.json ./apps/company-console/package.json
COPY apps/applicant-interview/package.json ./apps/applicant-interview/package.json

RUN npm ci

COPY apps ./apps
COPY packages ./packages

RUN npm run build --workspace @iep/company-console \
    && npm run build --workspace @iep/applicant-interview

FROM nginx:1.27-alpine AS company-console
COPY apps/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/company-console/dist /usr/share/nginx/html
EXPOSE 8080

FROM nginx:1.27-alpine AS applicant-interview
COPY apps/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/applicant-interview/dist /usr/share/nginx/html
EXPOSE 8080
