# Used only when Cognito settings are absent. Match LOCAL_COMPANY_ACCESS_TOKEN in the root .env.
VITE_LOCAL_COMPANY_TOKEN=local-company-access-token

# Optional public login hint for the pre-created Cognito judge account. Never put its password
# in a VITE_ variable: Vite embeds these values in the browser bundle.
VITE_DEMO_COMPANY_EMAIL=judge-demo@example.com
