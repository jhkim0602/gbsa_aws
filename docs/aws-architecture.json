{
  "title": "Interview Evidence Platform - AWS Deployment",
  "subtitle": "Production topology in Asia Pacific (Seoul), ap-northeast-2",
  "theme": "light",
  "size": "wide",
  "nodes": [
    {"id": "users", "service": "users", "label": "Recruiters / Applicants", "x": 0, "y": 2},
    {"id": "waf", "service": "waf", "label": "AWS WAF", "sublabel": "Edge protection", "x": 1, "y": 0, "container": "region"},
    {"id": "edge", "service": "cloudfront", "label": "Amazon CloudFront", "sublabel": "HTTPS / WebSocket edge", "x": 1, "y": 2, "container": "cloud"},
    {"id": "spa", "service": "s3", "label": "Amazon S3", "sublabel": "Company / Applicant SPAs", "x": 2, "y": 4, "container": "region"},
    {"id": "cognito", "service": "cognito", "label": "Amazon Cognito", "sublabel": "Company authentication", "x": 2, "y": 0, "container": "region"},
    {"id": "alb", "service": "elb", "label": "Application Load Balancer", "x": 3, "y": 2, "container": "public-subnets"},
    {"id": "api", "service": "fargate", "label": "ECS Fargate API", "sublabel": "FastAPI + live interview", "x": 4, "y": 2, "container": "private-app"},
    {"id": "queues", "service": "sqs", "label": "Amazon SQS + DLQ", "sublabel": "Durable async workflows", "x": 5, "y": 0, "container": "region"},
    {"id": "worker", "service": "fargate", "label": "ECS Fargate Worker", "sublabel": "Analysis / media / reports / deletion", "x": 5, "y": 2, "container": "private-app"},
    {"id": "ai", "service": "bedrock", "label": "Managed AI Services", "sublabel": "Bedrock / Textract / Speech / MediaConvert", "x": 7, "y": 1, "container": "region"},
    {"id": "aurora", "service": "aurora", "label": "Aurora PostgreSQL", "sublabel": "Business data + pgvector + FTS", "x": 4, "y": 4, "container": "private-db"},
    {"id": "dynamodb", "service": "dynamodb", "label": "Amazon DynamoDB", "sublabel": "Recent interview context", "x": 6, "y": 4, "container": "region"},
    {"id": "data", "service": "s3", "label": "Amazon S3 + KMS", "sublabel": "Source / media / reports / audit", "x": 7, "y": 4, "container": "region"}
  ],
  "connections": [
    {"source": "users", "target": "edge", "label": "HTTPS / WSS", "style": "solid", "step_number": 1},
    {"source": "waf", "target": "edge", "label": "Web ACL", "style": "dashed"},
    {"source": "edge", "target": "spa", "label": "Static assets", "style": "solid"},
    {"source": "edge", "target": "alb", "label": "/api and /ws", "style": "solid", "step_number": 2},
    {"source": "users", "target": "cognito", "label": "Company sign-in", "style": "solid"},
    {"source": "cognito", "target": "api", "label": "JWT", "style": "solid"},
    {"source": "alb", "target": "api", "label": "HTTP / WebSocket", "style": "solid", "step_number": 3},
    {"source": "api", "target": "queues", "label": "Outbox jobs", "style": "solid", "step_number": 4},
    {"source": "queues", "target": "worker", "label": "Consume / retry / DLQ", "style": "solid", "step_number": 5},
    {"source": "api", "target": "aurora", "label": "State + scoped hybrid retrieval", "style": "solid"},
    {"source": "api", "target": "ai", "label": "Live speech + questions", "style": "solid"},
    {"source": "worker", "target": "ai", "label": "Embeddings + post-processing", "style": "solid"},
    {"source": "worker", "target": "aurora", "label": "Vectors + derived records", "style": "solid"},
    {"source": "worker", "target": "data", "label": "Artifacts", "style": "solid"},
    {"source": "aurora", "target": "dynamodb", "label": "Recent-context projection", "style": "dashed"}
  ],
  "containers": [
    {"id": "cloud", "type": "aws-cloud", "label": "AWS Cloud", "parent": null, "children": ["region"]},
    {"id": "region", "type": "region", "label": "Asia Pacific (Seoul) - ap-northeast-2", "parent": "cloud", "children": ["vpc"]},
    {"id": "vpc", "type": "vpc", "label": "Multi-AZ VPC", "parent": "region", "children": ["public-subnets", "private-app", "private-db"]},
    {"id": "public-subnets", "type": "public-subnet", "label": "Public subnets", "parent": "vpc", "children": ["alb"]},
    {"id": "private-app", "type": "private-subnet", "label": "Private application subnets", "parent": "vpc", "children": ["api", "worker"]},
    {"id": "private-db", "type": "private-subnet", "label": "Private database subnets", "parent": "vpc", "children": ["aurora"]}
  ]
}
