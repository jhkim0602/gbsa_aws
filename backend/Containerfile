FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /workspace

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY backend/src ./backend/src

RUN uv sync --frozen --no-dev --no-editable

FROM base AS api
EXPOSE 8080
CMD ["uv", "run", "--no-sync", "uvicorn", "interview_evidence.main:app", "--host", "0.0.0.0", "--port", "8080"]

FROM base AS worker
CMD ["uv", "run", "--no-sync", "python", "-m", "interview_evidence.worker"]
